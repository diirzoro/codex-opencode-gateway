#include <tunables/global>

profile opencode-preview flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  file,
  network,
  capability,
  signal,
  ptrace (trace,read,tracedby,readby) peer=opencode-preview,
  deny mount,
  deny network raw,
  deny /sys/** wklx,
  deny /proc/sys/** wklx,
  deny /proc/sysrq-trigger rwklx,
  deny /proc/kcore rwklx,
}
