# Ready-to-fill fragment; merge into the existing protected VPS .env.
# ALL empty assignments below are placeholders: fill before restarting.
# Do not commit a filled copy; do not replace the rest of the existing .env.
# Known public server IP: 162.35.127.135. No public HTTPS origin is assumed.
APP_HOST=127.0.0.1
APP_PORT=8000
# Reference/health only; workspace activity uses its own dynamic loopback runtime.
OPENCODE_BASE_URL=http://127.0.0.1:4096

# PENDING_PUBLIC_HTTPS_URL
PUBLIC_BASE_URL=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GITHUB_APP_PRIVATE_KEY_PATH=/home/tahir/secrets/github-app.private-key.pem

# Must match PUBLIC_BASE_URL + /api/github/callback and the GitHub App callback.
# PENDING_PUBLIC_HTTPS_URL
GITHUB_CALLBACK_URL=

# Preserve the existing persistent encryption key; do not rotate it during setup.
CREDENTIALS_ENCRYPTION_KEY=

# Required for the recommended webhook-enabled setup.
# If webhooks are deliberately disabled, omit this assignment.
GITHUB_WEBHOOK_SECRET=

# OMIT GITHUB_APP_PRIVATE_KEY when using the file-path option.
# OMIT GITHUB_API_BASE and GITHUB_WEB_BASE for the GitHub.com defaults.
# No GitHub frontend env values, PAT, or GITHUB_TOKEN are needed by this backend.
