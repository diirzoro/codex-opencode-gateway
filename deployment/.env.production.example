# Future deployment template only; no real credentials. Public agent execution stays disabled.
# Only these environment values change between local and production; no code change is required.
DATABASE_URL=postgresql+psycopg://opencode_gateway:REPLACE_LOCALLY@127.0.0.1:5432/opencode_gateway
SESSION_COOKIE_NAME=gateway_session
SESSION_DAYS=14
COOKIE_SECURE=true
APP_HOST=127.0.0.1
APP_PORT=8000
PUBLIC_BASE_URL=https://REPLACE_WITH_PUBLIC_DOMAIN
OPENCODE_RUNTIME_MODE=local
# Backend only. Existing OpenCode service binds localhost and has no shared login.
# Reference/health only; never use this shared process for customer sessions.
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_BINARY=opencode
WORKSPACE_ROOT=/var/lib/opencode-workspaces
RUNTIME_ROOT=/var/lib/opencode-runtime
# GitHub App: set the real App id/slug/private key and the HTTPS callback URL.
GITHUB_APP_ID=000000
GITHUB_APP_SLUG=REPLACE_WITH_APP_SLUG
GITHUB_APP_PRIVATE_KEY_PATH=/home/tahir/secrets/github-app.private-key.pem
GITHUB_CLIENT_ID=REPLACE_WITH_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
GITHUB_CALLBACK_URL=https://REPLACE_WITH_PUBLIC_DOMAIN/api/github/callback
GITHUB_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET
# Key for encrypted server-side credential persistence, stored outside the database.
CREDENTIALS_ENCRYPTION_KEY=REPLACE_WITH_LONG_RANDOM_VALUE

# Password recovery requires HTTPS PUBLIC_BASE_URL and SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
# Configure only after sandbox acceptance. Secrets remain backend-only.
PAYPAL_ENVIRONMENT=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_SANDBOX_DECLINE=false
