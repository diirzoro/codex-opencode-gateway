# Ready-to-fill deployment template; no real credentials. Merge into existing VPS .env.
# Known public server IP: 162.35.127.135 (not an assumed public HTTPS application URL).
# Fill pending values before restarting; preserve existing database/encryption credentials.
DATABASE_URL=postgresql+psycopg://opencode_gateway:REPLACE_LOCALLY@127.0.0.1:5432/opencode_gateway
SESSION_COOKIE_NAME=gateway_session
SESSION_DAYS=14
COOKIE_SECURE=true
APP_HOST=127.0.0.1
APP_PORT=8000
# PENDING_PUBLIC_HTTPS_URL: actual public HTTPS application origin, not localhost.
PUBLIC_BASE_URL=
OPENCODE_RUNTIME_MODE=local
# Backend only. Existing OpenCode service binds localhost and has no shared login.
# Reference/health only; never use this shared process for customer sessions.
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_BINARY=opencode
WORKSPACE_ROOT=/var/lib/opencode-workspaces
RUNTIME_ROOT=/var/lib/opencode-runtime
# GitHub App: real App identity not supplied; fill from the existing/reused App.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=/home/tahir/secrets/github-app.private-key.pem
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# PENDING_PUBLIC_HTTPS_URL: final origin + /api/github/callback; match GitHub App settings.
GITHUB_CALLBACK_URL=
# Required only when GitHub App webhooks are enabled.
GITHUB_WEBHOOK_SECRET=
# Key for encrypted server-side credential persistence, stored outside the database.
CREDENTIALS_ENCRYPTION_KEY=

# Optional Google sign-in identity. Configure the provider callback for:
# PUBLIC_BASE_URL + /api/auth/social/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Password recovery requires HTTPS PUBLIC_BASE_URL and SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
# Configure only after sandbox acceptance. Secrets remain backend-only.
PAYPAL_ENVIRONMENT=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_SANDBOX_DECLINE=false