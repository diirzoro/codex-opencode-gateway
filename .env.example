# Local development example only. Copy to .env manually; never use production credentials.
# Every value below is read from the environment at startup. Changing any value requires no code change.
DATABASE_URL=postgresql+psycopg://gateway_local:REPLACE_LOCAL_PASSWORD@127.0.0.1:55432/gateway_local
SESSION_COOKIE_NAME=gateway_session
SESSION_DAYS=14
COOKIE_SECURE=false
APP_HOST=127.0.0.1
APP_PORT=8180
# Public origin used for post-callback redirects. Production sets the real HTTPS domain.
PUBLIC_BASE_URL=http://127.0.0.1:8180
# disabled by default. local is trusted localhost development, never public isolation.
OPENCODE_RUNTIME_MODE=disabled
OPENCODE_BINARY=opencode
# Shared OpenCode internal URL used for health diagnostics only. Per-workspace runtimes bind an ephemeral loopback port.
OPENCODE_URL=http://127.0.0.1:4196
# Optional absolute local paths; defaults are project/workspaces and project/runtime.
# WORKSPACE_ROOT=D:/opencode-local/workspaces
# RUNTIME_ROOT=D:/opencode-local/runtime

# --- GitHub App (real external integration; empty = truthful "not configured") ---
# Create a GitHub App and set these. The callback URL must match the App's setup/callback URL.
# GITHUB_APP_ID=000000
# GITHUB_APP_SLUG=your-app-slug
# GITHUB_APP_PRIVATE_KEY_PATH=D:/secrets/github-app.private-key.pem
# GITHUB_CLIENT_ID=Iv1.xxxxxxxx
# GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxx
GITHUB_CALLBACK_URL=http://127.0.0.1:8180/api/github/callback
# GITHUB_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx
# GITHUB_API_BASE=https://api.github.com
# GITHUB_WEB_BASE=https://github.com

# Required for billing and persisted GitHub/provider secrets. Keep outside the database.
# CREDENTIALS_ENCRYPTION_KEY=REPLACE_WITH_LONG_RANDOM_VALUE

# Production HTTPS example: deployment/.env.production.example

# Password recovery: configure HTTPS PUBLIC_BASE_URL and SMTP; secrets stay outside Git.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
