# Local PostgreSQL example only. Copy manually; do not use production credentials.
DATABASE_URL=postgresql+psycopg://gateway_local:REPLACE_LOCAL_PASSWORD@127.0.0.1:5432/gateway_local
SESSION_COOKIE_NAME=gateway_session
SESSION_DAYS=14
COOKIE_SECURE=false
APP_HOST=127.0.0.1
APP_PORT=8000
# disabled by default. local is trusted localhost development, never public isolation.
OPENCODE_RUNTIME_MODE=disabled
OPENCODE_BINARY=opencode
OPENCODE_URL=http://127.0.0.1:4096
# Optional absolute local paths; defaults are project/workspaces and project/runtime.
# WORKSPACE_ROOT=D:/opencode-local/workspaces
# RUNTIME_ROOT=D:/opencode-local/runtime
# Production HTTPS example: deployment/.env.production.example
